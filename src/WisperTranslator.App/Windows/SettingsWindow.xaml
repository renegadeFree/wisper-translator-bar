<ui:FluentWindow x:Class="WisperTranslator.App.Windows.SettingsWindow"
                 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                 xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
                 xmlns:controls="clr-namespace:WisperTranslator.App.Controls"
                 Title="Impostazioni"
                 Width="680"
                 Height="680"
                 WindowBackdropType="Mica"
                 WindowCornerPreference="Round"
                 ExtendsContentIntoTitleBar="True"
                 WindowStartupLocation="CenterOwner">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ui:TitleBar Grid.Row="0" Title="Impostazioni" ShowMaximize="False" />

        <TabControl Grid.Row="1" x:Name="Tabs" Margin="12,4,12,0" SelectionChanged="OnTabChanged">
            <TabItem Header="Aspetto">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                    <StackPanel>
                        <controls:SliderRow x:Name="FontRow" Label="Dimensione testo widget"
                                            Minimum="10" Maximum="32" TickFrequency="1"
                                            ValueFormat="{}{0:0} px" ValueChanged="OnAppearanceChanged" />
                        <controls:SliderRow x:Name="OpacityRow" Label="Opacità finestra" Margin="0,12,0,0"
                                            Minimum="0.4" Maximum="1" TickFrequency="0.05"
                                            ValueFormat="{}{0:P0}" ValueChanged="OnAppearanceChanged" />
                        <controls:SliderRow x:Name="MaxCuesRow" Label="Battute massime nel widget" Margin="0,12,0,0"
                                            Minimum="3" Maximum="20" TickFrequency="1"
                                            ValueFormat="{}{0:0} frasi" ValueChanged="OnAppearanceChanged" />
                        <controls:SliderRow x:Name="OverlayCuesRow" Label="Battute nell'overlay" Margin="0,12,0,0"
                                            Minimum="1" Maximum="6" TickFrequency="1"
                                            ValueFormat="{}{0:0} frasi" ValueChanged="OnAppearanceChanged" />
                        <controls:SliderRow x:Name="OverlayFontRow" Label="Dimensione testo overlay" Margin="0,12,0,0"
                                            Minimum="16" Maximum="56" TickFrequency="2"
                                            ValueFormat="{}{0:0} px" ValueChanged="OnAppearanceChanged" />
                        <controls:SliderRow x:Name="RetentionRow" Label="Conservazione delle sessioni" Margin="0,12,0,0"
                                            Minimum="0" Maximum="90" TickFrequency="1"
                                            ValueFormat="{}{0:0} giorni" ZeroText="per sempre"
                                            ValueChanged="OnAppearanceChanged" />

                        <CheckBox x:Name="TopmostCheck" Content="Sempre in primo piano" Margin="0,16,0,0"
                                  Click="OnAppearanceChanged" />
                        <CheckBox x:Name="ShowOriginalCheck" Content="Mostra anche il testo originale" Margin="0,8,0,0"
                                  Click="OnAppearanceChanged" />
                        <CheckBox x:Name="TranslateCheck" Content="Traduci le battute" Margin="0,8,0,0"
                                  Click="OnAppearanceChanged" />
                        <CheckBox x:Name="OverlayCaptureCheck" Content="Nascondi l'overlay dalle registrazioni"
                                  Margin="0,8,0,0" Click="OnAppearanceChanged" />
                        <CheckBox x:Name="CloseToTrayCheck" Content="Chiudendo la finestra resta nella barra delle applicazioni"
                                  Margin="0,8,0,0" Click="OnAppearanceChanged" />
                        <CheckBox x:Name="StartWithWindowsCheck" Content="Avvia con Windows"
                                  Margin="0,8,0,0" Click="OnAppearanceChanged" />

                        <Separator Margin="0,16,0,12" />
                        <TextBlock Text="Dispositivo audio di sistema" Margin="0,0,0,4" />
                        <ComboBox x:Name="SystemDeviceBox" DisplayMemberPath="Name" SelectionChanged="OnDeviceChanged" />
                        <TextBlock Text="Dispositivo microfono" Margin="0,12,0,4" />
                        <ComboBox x:Name="MicrophoneDeviceBox" DisplayMemberPath="Name" SelectionChanged="OnDeviceChanged" />

                        <TextBlock Margin="0,16,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Scorciatoie: Ctrl+Alt+W mostra/nascondi · Ctrl+Alt+S audio di sistema · Ctrl+Alt+N microfono · Ctrl+Alt+L inverti direzione · Ctrl+Alt+O overlay" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Prestazioni">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                    <StackPanel>
                        <Border Padding="10" CornerRadius="6" Margin="0,0,0,12"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock x:Name="HardwareText" TextWrapping="Wrap" />
                                <TextBlock x:Name="ProfileSummaryText" Margin="0,8,0,0" TextWrapping="Wrap"
                                           FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>

                        <TextBlock Text="Profilo prestazioni consigliato" Margin="0,0,0,4" />
                        <ComboBox x:Name="PresetBox" DisplayMemberPath="Label" SelectionChanged="OnPresetChanged" />
                        <TextBlock x:Name="PresetHint" Margin="0,6,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="Applica profilo" Padding="10,4" Click="OnApplyProfileClicked" />
                            <Button Content="Scarica ciò che manca" Padding="10,4" Margin="8,0,0,0"
                                    Click="OnDownloadProfileModelsClicked" />
                            <Button Content="Verifica integrità" Padding="10,4" Margin="8,0,0,0"
                                    Click="OnVerifyProfileClicked" />
                        </StackPanel>
                        <ProgressBar x:Name="ProfileProgress" Height="6" Margin="0,10,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="ProfileStatusText" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <Separator Margin="0,16,0,12" />
                        <TextBlock Text="Motori di trascrizione per corsia" FontWeight="SemiBold" Margin="0,0,0,8" />

                        <Border Padding="10" CornerRadius="6" Margin="0,0,0,8"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="Testo immediato (streaming mentre parli)" FontWeight="Medium" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Motore istantaneo" FontSize="11" Margin="0,0,0,3" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ComboBox x:Name="LiveBackendBox" DisplayMemberPath="Label" SelectionChanged="OnBackendChanged" />
                                    </StackPanel>
                                    <StackPanel x:Name="LiveModelPanel" Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Modello Whisper istantaneo" FontSize="11" Margin="0,0,0,3" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ComboBox x:Name="PartialModelBox" DisplayMemberPath="Id" SelectionChanged="OnModelChanged" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Padding="10" CornerRadius="6" Margin="0,0,0,12"
                                Background="{DynamicResource ControlFillColorDefaultBrush}">
                            <StackPanel>
                                <TextBlock Text="Frase definitiva (a fine respiro)" FontWeight="Medium" Margin="0,0,0,6" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,6,0">
                                        <TextBlock Text="Motore definitivo" FontSize="11" Margin="0,0,0,3" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ComboBox x:Name="FinalBackendBox" DisplayMemberPath="Label" SelectionChanged="OnBackendChanged" />
                                    </StackPanel>
                                    <StackPanel x:Name="FinalModelPanel" Grid.Column="1" Margin="6,0,0,0">
                                        <TextBlock Text="Modello Whisper definitivo" FontSize="11" Margin="0,0,0,3" Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                        <ComboBox x:Name="FinalModelBox" DisplayMemberPath="Id" SelectionChanged="OnModelChanged" />
                                    </StackPanel>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock x:Name="ModelHint" Margin="0,0,0,8" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Separator Margin="0,8,0,12" />
                        <TextBlock Text="Architettura e opzioni di traduzione" FontWeight="SemiBold" Margin="0,0,0,8" />
                        
                        <TextBlock Text="Modalità pipeline" Margin="0,0,0,4" />
                        <ComboBox x:Name="TranslationPipelineBox" DisplayMemberPath="Label"
                                  SelectionChanged="OnTranslationPipelineChanged" />
                        <TextBlock x:Name="TranslationPipelineHint" Margin="0,6,0,8" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Text="Rifinitura di qualità (Marian ONNX)" Margin="0,4,0,4" />
                        <ComboBox x:Name="TranslationQualityBox" DisplayMemberPath="Label"
                                  SelectionChanged="OnTranslationQualityChanged" />
                        <TextBlock x:Name="TranslationQualityHint" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                        <Button Content="Scarica i modelli di rifinitura (Marian ONNX)" Padding="10,4" Margin="0,8,0,0"
                                Click="OnDownloadQualityModelsClicked" />

                        <CheckBox x:Name="ContinuousTranslationBox" Margin="0,14,0,0"
                                  Content="Continuità: traduci le ultime due frasi come una sola"
                                  Checked="OnContinuousTranslationChanged" Unchecked="OnContinuousTranslationChanged" />
                        <TextBlock Margin="0,4,0,6" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Con l'opzione attiva il motore di qualità riceve le ultime due frasi finali unite in una frase sola: pronomi e termini non cambiano più da una riga all'altra. Vale solo con la traduzione attiva e fuori dalla modalità conversazione." />

                        <controls:SliderRow x:Name="SentenceMinWordsRow" Label="Parole minime per riga"
                                            Margin="0,6,0,0" Minimum="0" Maximum="40" TickFrequency="1"
                                            ValueFormat="{}{0:0} parole" ZeroText="nessun minimo"
                                            ValueChanged="OnSentenceWordsChanged" />
                        <controls:SliderRow x:Name="SentenceMaxWordsRow" Label="Parole massime per riga"
                                            Margin="0,10,0,0" Minimum="2" Maximum="60" TickFrequency="1"
                                            ValueFormat="{}{0:0} parole"
                                            ValueChanged="OnSentenceWordsChanged" />
                        <TextBlock x:Name="SentenceWordsHint" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <Separator Margin="0,16,0,12" />
                        <TextBlock Text="Accelerazione GPU (sperimentale)" Margin="0,0,0,4" />
                        <ComboBox x:Name="GpuBox" DisplayMemberPath="Label" SelectionChanged="OnGpuChanged" />
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Il programma funziona sempre su CPU. Le build Vulkan/CUDA vengono pubblicate solo dopo una verifica misurata: finché il profilo non le seleziona, restano indicate come sperimentali." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Conversazione">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Nelle riunioni e nelle call: il microfono resta &quot;Tu&quot;, l'audio di sistema viene diviso per parlante. La diarizzazione lavora solo sulle frasi definitive, quindi il testo immediato resta veloce come prima." />

                        <CheckBox x:Name="ConversationCheck" Content="Attiva la modalità conversazione"
                                  Click="OnConversationChanged" />

                        <TextBlock Text="Diarizzatore" Margin="0,14,0,4" />
                        <ComboBox x:Name="DiarizerBox" DisplayMemberPath="Label" SelectionChanged="OnDiarizerChanged" />
                        <TextBlock x:Name="DiarizerHint" Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <ui:Button x:Name="DiarizerDownloadButton" Content="Scarica il diarizzatore"
                                       Icon="{ui:SymbolIcon ArrowDownload24}" Padding="12,5"
                                       Click="OnDownloadDiarizerClicked" />
                            <Button Content="Verifica" Padding="10,4" Margin="8,0,0,0" Click="OnVerifyDiarizerClicked" />
                        </StackPanel>
                        <ProgressBar x:Name="DiarizerProgress" Height="6" Margin="0,10,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="DiarizerStatusText" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <Separator Margin="0,16,0,12" />
                        <TextBlock TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Limiti dichiarati: le voci sovrapposte o molto simili possono essere confuse; Sortformer (predefinito) separa fino a 4 parlanti e Nemotron fino a 8. I nomi non vengono ricordati tra una sessione e l'altra. Su PC con poca memoria la diarizzazione resta spenta finché non la si scarica qui." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Barra">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="La barra fluttuante sta sopra le altre finestre, si trascina ovunque e si aggancia ai bordi. Le frasi oltre quelle visibili restano sotto: si raggiungono con la rotellina del mouse mentre il puntatore è sulla barra." />

                        <CheckBox x:Name="BarEnabledCheck" Content="Mostra la barra all'avvio" Click="OnBarChanged" />
                        <CheckBox x:Name="BarMiniIdleCheck" Content="Riduci a pillola quando non ci sono sottotitoli"
                                  Margin="0,8,0,0" Click="OnBarChanged" />
                        <CheckBox x:Name="BarAnimationsCheck" Content="Animazioni (comparsa, respiro, scorrimento)"
                                  Margin="0,8,0,0" Click="OnBarChanged" />
                        <CheckBox x:Name="BarDiscreetCheck" Content="Modalità discreta: lascia passare i clic (maniglia esclusa)"
                                  Margin="0,8,0,0" Click="OnBarChanged" />

                        <TextBlock Text="Testo mostrato" Margin="0,14,0,4" />
                        <ComboBox x:Name="BarTextBox" SelectionChanged="OnBarChanged" />

                        <controls:SliderRow x:Name="BarRowsRow" Label="Frasi visibili" Margin="0,14,0,0"
                                            Minimum="1" Maximum="5" TickFrequency="1"
                                            ValueFormat="{}{0:0}" ValueChanged="OnBarChanged" />
                        <controls:SliderRow x:Name="BarFontRow" Label="Dimensione testo barra" Margin="0,12,0,0"
                                            Minimum="12" Maximum="26" TickFrequency="1"
                                            ValueFormat="{}{0:0} pt" ValueChanged="OnBarChanged" />
                        <controls:SliderRow x:Name="BarWidthRow" Label="Larghezza barra" Margin="0,12,0,0"
                                            Minimum="480" Maximum="1600" TickFrequency="20"
                                            ValueFormat="{}{0:0} px" ValueChanged="OnBarChanged" />
                        <controls:SliderRow x:Name="BarHeightRow" Label="Altezza barra" Margin="0,12,0,0"
                                            Minimum="120" Maximum="900" TickFrequency="10"
                                            ValueFormat="{}{0:0} px" ValueChanged="OnBarChanged" />
                        <controls:SliderRow x:Name="BarOpacityRow" Label="Trasparenza del vetro" Margin="0,12,0,0"
                                            Minimum="0.55" Maximum="0.92" TickFrequency="0.01"
                                            ValueFormat="{}{0:P0}" ValueChanged="OnBarChanged" />
                        <controls:SliderRow x:Name="BarBufferRow" Label="Frasi in memoria" Margin="0,12,0,0"
                                            Minimum="3" Maximum="8" TickFrequency="1"
                                            ValueFormat="{}{0:0}" ValueChanged="OnBarChanged" />

                        <TextBlock x:Name="BarPreviewText" Margin="0,14,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Modelli">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                    <StackPanel>
                        <TextBlock Margin="0,0,0,8" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Tutti i componenti scaricabili: modelli di trascrizione, runtime dei motori, disegno delle mappe e traduzione." />
                        <ItemsControl x:Name="ModelsList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,0,6" CornerRadius="6"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Size}" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding Detail}" FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding About}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="Scarica" Padding="10,3" Click="OnModelDownloadClicked" />
                                                <Button Content="Verifica" Padding="10,3" Margin="8,0,0,0"
                                                        Click="OnModelVerifyClicked" />
                                                <Button Content="Elimina" Padding="10,3" Margin="8,0,0,0"
                                                        Click="OnModelDeleteClicked" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <ProgressBar x:Name="ModelProgress" Height="6" Margin="0,10,0,0" Visibility="Collapsed" />
                        <TextBlock x:Name="ModelStatusText" Margin="0,6,0,0" TextWrapping="Wrap" />

                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                            <Button Content="Importa modello da file..." Padding="10,4" Click="OnImportModelClicked" />
                            <Button Content="Aggiorna elenco" Padding="10,4" Margin="8,0,0,0"
                                    Click="OnRefreshModelsClicked" />
                            <Button Content="Apri cartella" Padding="10,4" Margin="8,0,0,0" Click="OnOpenFolderClicked" />
                        </StackPanel>

                        <TextBlock x:Name="ModelFolderText" Margin="0,10,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Template">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                    <StackPanel>
                        <TextBlock TextWrapping="Wrap" Margin="0,0,0,8"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="I template dicono al modello come strutturare mappe e report, e a Graphviz come disegnarli. Sono file nella cartella Template: si possono modificare, importare ed esportare." />

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <Button Content="Importa cartella o zip..." Padding="10,4" Click="OnImportTemplateClicked" />
                            <Button Content="Apri cartella template" Padding="10,4" Margin="8,0,0,0"
                                    Click="OnOpenTemplatesFolderClicked" />
                            <Button Content="Aggiorna" Padding="10,4" Margin="8,0,0,0" Click="OnRefreshTemplatesClicked" />
                        </StackPanel>

                        <TextBlock x:Name="TemplateStatusText" TextWrapping="Wrap" Margin="0,0,0,10" />

                        <Image x:Name="TemplatePreview" MaxHeight="320" Stretch="Uniform" Margin="0,0,0,10" />

                        <ItemsControl x:Name="TemplatesList">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,0,6" CornerRadius="6"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Grid.Column="1" Text="{Binding Kind}" FontSize="11"
                                                           VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding Summary}" FontSize="11" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <TextBlock Text="{Binding Source}" FontSize="11" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="Anteprima" Padding="10,3" Click="OnPreviewTemplateClicked" />
                                                <Button Content="Esporta" Padding="10,3" Margin="8,0,0,0"
                                                        Click="OnExportTemplateClicked" />
                                                <Button Content="Elimina" Padding="10,3" Margin="8,0,0,0"
                                                        Click="OnDeleteTemplateClicked" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Storico">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                    <StackPanel>
                        <Border Padding="10" CornerRadius="6" Margin="0,0,0,10"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}">
                            <StackPanel>
                                <TextBlock x:Name="HistorySummary" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                    <Button Content="Aggiorna" Padding="10,4" Click="OnRefreshHistoryClicked" />
                                    <Button Content="Elimina sessioni scadute" Padding="10,4" Margin="8,0,0,0"
                                            Click="OnPurgeHistoryClicked" />
                                    <Button Content="Apri cartella dati" Padding="10,4" Margin="8,0,0,0"
                                            Click="OnOpenFolderClicked" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <ItemsControl x:Name="HistoryList" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="10" Margin="0,0,0,6" CornerRadius="6"
                                            Background="{DynamicResource ControlFillColorSecondaryBrush}">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Header}" FontWeight="SemiBold" />
                                            <TextBlock Text="{Binding Preview}" TextWrapping="Wrap" FontSize="12" Margin="0,2,0,0"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Button Content="SRT" Padding="10,3" Click="OnExportSrtClicked" />
                                                <Button Content="Testo" Padding="10,3" Margin="8,0,0,0"
                                                        Click="OnExportTextClicked" />
                                                <Button Content="JSON" Padding="10,3" Margin="8,0,0,0"
                                                        Click="OnExportJsonClicked" />
                                                <Button Content="Apri sessione" Padding="10,3" Margin="8,0,0,0"
                                                        Click="OnOpenSessionClicked" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Intelligenza artificiale">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                    <StackPanel>
                        <TextBlock Text="Provider" Margin="0,0,0,4" />
                        <ComboBox x:Name="AiProviderBox" DisplayMemberPath="Name"
                                  SelectionChanged="OnAiProviderChanged" />

                        <TextBlock Text="Endpoint" Margin="0,12,0,4" />
                        <TextBox x:Name="AiEndpointBox" LostFocus="OnAiTextChanged" />

                        <TextBlock Text="Modello" Margin="0,12,0,4" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ComboBox x:Name="AiModelBox" IsEditable="True" LostFocus="OnAiTextChanged"
                                      SelectionChanged="OnAiTextChanged" />
                            <Button Grid.Column="1" Content="Rileva modelli" Padding="10,4" Margin="8,0,0,0"
                                    Click="OnDetectModelsClicked" ToolTip="Elenca i modelli installati in Ollama o LM Studio" />
                        </Grid>

                        <TextBlock Text="Chiave API (vuota per i servizi locali)" Margin="0,12,0,4" />
                        <PasswordBox x:Name="AiKeyBox" LostFocus="OnAiSecretChanged" />

                        <TextBlock Text="Lingua dei testi generati" Margin="0,12,0,4" />
                        <ComboBox x:Name="AiLanguageBox" SelectionChanged="OnAiTextChanged">
                            <ComboBoxItem Content="Italiano" />
                            <ComboBoxItem Content="Inglese" />
                        </ComboBox>

                        <controls:SliderRow x:Name="AiTemperatureRow" Margin="0,12,0,0"
                                            Label="Temperatura (0 = preciso, 1 = creativo)"
                                            Minimum="0" Maximum="1" TickFrequency="0.1"
                                            ValueFormat="{}{0:0.0}" ValueChanged="OnAiSliderChanged" />

                        <TextBlock Text="Token massimi di risposta" Margin="0,12,0,4" />
                        <TextBox x:Name="AiMaxTokensBox" LostFocus="OnAiTextChanged" />

                        <TextBlock Text="Timeout (secondi)" Margin="0,12,0,4" />
                        <TextBox x:Name="AiTimeoutBox" LostFocus="OnAiTextChanged" />

                        <CheckBox x:Name="AiSkipReasoningCheck"
                                  Content="Salta il ragionamento dei modelli thinking (consigliato)"
                                  Margin="0,12,0,0" Click="OnAiCheckChanged" />

                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <ui:Button x:Name="AiTestButton" Content="Testa la connessione"
                                       Icon="{ui:SymbolIcon Sparkle24}" Padding="12,5"
                                       Click="OnTestAiClicked" />
                            <Button Content="Provider noti" Padding="12,5" Margin="8,0,0,0"
                                    Click="OnAiPresetsClicked" />
                        </StackPanel>

                        <TextBlock x:Name="AiStatusText" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <TextBlock Margin="0,14,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Con Ollama (locale) e LM Studio nessun dato esce dal PC. Con i provider cloud il testo della sessione viene inviato al servizio scelto e la chiave resta salvata solo su questo computer." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>

            <TabItem Header="Aggiornamenti">
                <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="4,8,12,8">
                    <StackPanel>
                        <TextBlock Text="Aggiornamenti da GitHub" FontWeight="SemiBold" Margin="0,0,0,8" />
                        <TextBlock x:Name="UpdateCurrentText" Margin="0,0,0,10" />
                        <TextBlock Margin="0,0,0,12" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Il controllo legge l'ultima release pubblicata su GitHub. L'installer viene scaricato, verificato con lo SHA-256 della release e avviato in silenzio: al termine l'applicazione si riapre da sola." />

                        <StackPanel Orientation="Horizontal">
                            <ui:Button x:Name="UpdateCheckButton" Content="Controlla aggiornamenti"
                                       Icon="{ui:SymbolIcon ArrowSync24}" Padding="12,5"
                                       Click="OnCheckUpdatesClicked" />
                            <ui:Button x:Name="UpdateInstallButton" Content="Scarica e installa"
                                       Icon="{ui:SymbolIcon ArrowDownload24}" Padding="12,5" Margin="8,0,0,0"
                                       IsEnabled="False" Click="OnInstallUpdateClicked" />
                        </StackPanel>

                        <ProgressBar x:Name="UpdateProgress" Height="4" Margin="0,14,0,0"
                                     Minimum="0" Maximum="1" Visibility="Collapsed" />
                        <TextBlock x:Name="UpdateStatusText" Margin="0,10,0,0" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" />

                        <CheckBox x:Name="AutoCheckUpdatesBox" Margin="0,16,0,0"
                                  Content="Controlla gli aggiornamenti all'avvio"
                                  Checked="OnAutoCheckUpdatesChanged" Unchecked="OnAutoCheckUpdatesChanged" />
                        <TextBlock Margin="0,6,0,0" TextWrapping="Wrap" FontSize="11"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   Text="Il controllo all'avvio non scarica nulla: se c'è una versione nuova lo segnala e l'aggiornamento resta a un tuo clic." />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="12">
            <Button Content="Chiudi" Padding="14,5" Click="OnCloseClicked" />
        </StackPanel>
    </Grid>
</ui:FluentWindow>
